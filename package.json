{
  "name": "prisma-seeder",
  "version": "2.0.0",
  "packageManager": "pnpm@9.12.0",
  "description": "Adds seeding support to Prisma ORM for populating your database with initial data.",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "imports": {
    "#src/*": "./src/*"
  },
  "scripts": {
    "build": "tsdown",
    "prepublishOnly": "tsc && pnpm build",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "prisma": {
    "schema": "./examples/prisma/schema.prisma"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/esmerlingb/prisma-seeder.git"
  },
  "homepage": "https://github.com/esmerlingb/prisma-seeder#readme",
  "bugs": {
    "url": "https://github.com/esmerlingb/prisma-seeder/issues"
  },
  "keywords": [
    "prisma",
    "seed",
    "seeding",
    "migration",
    "database",
    "db"
  ],
  "peerDependencies": {
    "@prisma/client": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "@prisma/client": {
      "optional": true
    }
  },
  "dependencies": {
    "commander": "^13.1.0",
    "glob": "^11.0.1"
  },
  "devDependencies": {
    "@prisma/client": "^6.7.0",
    "@types/node": "^24.19.2",
    "prettier": "^3.9.10",
    "prisma": "^6.7.0",
    "tsdown": "^0.23.1",
    "tslib": "^2.7.0",
    "tsx": "^4.23.15",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=20"
  }
}
